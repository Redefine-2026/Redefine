      </a>
    </div>
    <p class="note">₹150 per ticket. Both links open VIT’s official registration portals in a new tab.</p>
  </div>
</div>

<script>
(function(){
  "use strict";
  var $ = function(s,r){ return (r||document).querySelector(s); };
  var $$ = function(s,r){ return Array.prototype.slice.call((r||document).querySelectorAll(s)); };
  var esc = function(s){ return String(s==null?"":s).replace(/[&<>"']/g, function(c){
    return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]; }); };

  var TRACKS = [
    {k:"01", n:"Music & Streaming", d:"Reinvent Spotify — or any service built on playlists, queues and recommendation feeds."},
    {k:"02", n:"E-Commerce",        d:"Transform how people browse, compare, decide and check out. Carts are a convention, not a law."},
    {k:"03", n:"Social Platforms",  d:"Redesign the feed, the profile, the timeline. Rethink what people are actually there for."},
    {k:"04", n:"Productivity Tools",d:"Notes, tasks, calendars, docs. Question the metaphors we inherited from paper."},
    {k:"05", n:"Entertainment",     d:"Streaming, gaming, reading. Reimagine how a story or a session is discovered and consumed."},
    {k:"06", n:"Everyday Apps",     d:"Banking, transit, weather, health. The screens people open without thinking."}
  ];
  $("#trackGrid").innerHTML = TRACKS.map(function(t){
    return '<article class="card"><span class="card-k">'+esc(t.k)+'</span><h3>'+esc(t.n)+
           '</h3><p>'+esc(t.d)+'</p><span class="card-foot">SAMPLE CATEGORY</span></article>';
  }).join("");

  /* countdown to the opening bell */
  var EVENT_START = new Date("2026-09-16T08:00:00+05:30");
  var cd = { d:$('[data-cd="d"]'), h:$('[data-cd="h"]'), m:$('[data-cd="m"]'), s:$('[data-cd="s"]') };
  function pad(n){ return (n<10?"0":"") + n; }
  function tickClock(){
    var ms = EVENT_START - Date.now();
    if (ms <= 0){ ["d","h","m","s"].forEach(function(k){ cd[k].textContent = "00"; }); return; }
    var t = Math.floor(ms/1000);
    cd.d.textContent = pad(Math.floor(t/86400));
    cd.h.textContent = pad(Math.floor(t%86400/3600));
    cd.m.textContent = pad(Math.floor(t%3600/60));
    cd.s.textContent = pad(t%60);
  }
  tickClock(); setInterval(tickClock, 1000);

  /* the bar appears once the artwork is behind you */
  var bar = $("#bar"), stage = $(".stage");
  var cue = $("#cue");
  function onScroll(){
    bar.classList.toggle("shown", window.scrollY > stage.offsetHeight - 90);
    cue.classList.toggle("gone", window.scrollY > 60);
  }
  onScroll();
  window.addEventListener("scroll", onScroll, {passive:true});
  window.addEventListener("resize", onScroll);

  /* optional logo: drop logo.svg or logo.png beside this file */
  (function(){
    var names = ["logo.svg","logo.png"];
    (function next(i){
      if (i >= names.length) return;
      var probe = new Image();
      probe.onload = function(){ $("#hdrLogo").src = names[i]; document.body.classList.add("has-logo"); };
      probe.onerror = function(){ next(i+1); };
      probe.src = names[i];
    })(0);
  })();

  /* a glowing pen stands in for the cursor over anything clickable on the artwork */
  (function(){
    if (!window.matchMedia || !window.matchMedia("(hover:hover) and (pointer:fine)").matches) return;
    var pen = $("#pen"), x = 0, y = 0, queued = false;
    function paint(){
      queued = false;
      pen.style.transform = "translate3d(" + (x - 6) + "px," + (y - 28) + "px,0)";
    }
    function move(e){
      x = e.clientX; y = e.clientY;
      if (!queued){ queued = true; requestAnimationFrame(paint); }
    }
    $$(".hot").forEach(function(el){
      el.addEventListener("mouseenter", function(e){ move(e); paint(); pen.classList.add("on"); });
      el.addEventListener("mousemove", move);
      el.addEventListener("mouseleave", function(){ pen.classList.remove("on"); });
    });
    window.addEventListener("blur", function(){ pen.classList.remove("on"); });
  })();

  /* registration chooser */
  var scrim = $("#scrim"), lastFocus = null;
  function openModal(){
    lastFocus = document.activeElement;
    scrim.hidden = false;
    document.body.style.overflow = "hidden";
    setTimeout(function(){ $(".route", scrim).focus(); }, 30);
  }
  function closeModal(){
    scrim.hidden = true;
    document.body.style.overflow = "";
    if (lastFocus && lastFocus.focus) lastFocus.focus();
  }
  $$("[data-open]").forEach(function(b){ b.addEventListener("click", openModal); });
  $("#closeBtn").addEventListener("click", closeModal);
  scrim.addEventListener("mousedown", function(e){ if (e.target === scrim) closeModal(); });
  document.addEventListener("keydown", function(e){
    if (e.key === "Escape" && !scrim.hidden) closeModal();
    if (e.key === "Tab" && !scrim.hidden){
      var f = $$('button, a[href]', scrim).filter(function(el){ return el.offsetParent !== null; });
      if (!f.length) return;
      var first = f[0], last = f[f.length-1];
      if (e.shiftKey && document.activeElement === first){ e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last){ e.preventDefault(); first.focus(); }
    }
  });
})();
</script>
